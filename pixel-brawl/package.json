{
  "name": "pixel-brawl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pixel Brawl — a retro 2D arena brawler io-game (accounts, boxes, brawler cards, 4 game modes, bots & online play).",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx src/server/index.ts",
    "serve": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
